# Host-side file: /secure/skanida/robin.env. Never commit the populated file.
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
ENVIRONMENT=production

MODEL_PATH=/app/runtime-models/glintr100.onnx
MODEL_INPUT_SIZE=112
EMBEDDING_DIM=512
SKIP_MODEL_LOAD=false
AUTO_DOWNLOAD_MODELS=false
GPU_DEVICE_ID=-1
GPU_MEM_LIMIT=2147483648

CORS_ALLOWED_ORIGINS=https://api.school.example
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BYTES=62914560
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16777216

ROBIN_SERVICE_TOKEN=replace-with-the-same-secret-as-astra
FACE_MATCH_THRESHOLD=0.6

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_COLLECTION_NAME=face_embeddings
QDRANT_API_KEY=replace-with-target-qdrant-api-key
QDRANT_TIMEOUT_SECONDS=3
