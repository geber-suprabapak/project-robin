# ===================================
# Face Recognition API Configuration
# ===================================

# ===== Image Configuration =====
# Used by docker compose. Defaults match the CI-published CPU image.
IMAGE_NAME=ghcr.io/lunaradevs/project-robin
IMAGE_TAG=cpu-latest

# ===== Model Configuration =====
# Path to ONNX model file (AuraFace recommended for production)
MODEL_PATH=./models/arcface_r100_224x224.onnx

# Model input size (Hi-Res ArcFace uses 224x224)
MODEL_INPUT_SIZE=224

# Face embedding dimension (typically 512 for ArcFace)
EMBEDDING_DIM=512

# CI smoke tests can start the API without a model. Keep false for real runtime.
SKIP_MODEL_LOAD=false

# ===== GPU Configuration =====
# GPU Device ID (0 for first GPU, -1 for CPU only)
GPU_DEVICE_ID=-1

# GPU Memory Limit in bytes (2GB = 2147483648)
GPU_MEM_LIMIT=2147483648

# ===== API Server Configuration =====
API_HOST=0.0.0.0
API_PORT=8000

# API Environment (development, production)
ENVIRONMENT=development

# Number of workers (only active in production mode)
API_WORKERS=1

# ===== Supabase Configuration =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret for verifying Supabase session tokens (Dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ===== Face Recognition Configuration =====
# Minimum confidence threshold for face matching (0.0 to 1.0)
FACE_MATCH_THRESHOLD=0.6

# Maximum distance for cosine similarity (lower is better)
MAX_COSINE_DISTANCE=0.4

# ===== Security Configuration =====
# Set Secret key for admin-only endpoints (e.g., enrollment)
ADMIN_SECRET_KEY=your-admin-secret-key-here

# ===== Qdrant Configuration =====
# Qdrant is external-only in this compose stack.
QDRANT_HOST=https://your-qdrant-host.example.com

# Qdrant port (default: 6333 for REST API)
QDRANT_PORT=6333

# Collection name for face embeddings
QDRANT_COLLECTION_NAME=face_embeddings

# Qdrant API key (optional, required for Qdrant Cloud)
QDRANT_API_KEY=

# Whether to use HTTPS for Qdrant (default: true)
QDRANT_HTTPS=true
