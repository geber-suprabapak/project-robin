# ===================================
# Face Recognition API Configuration
# ===================================

# ===== Model Configuration =====
# Path to ONNX model file (ArcFace recommended)
MODEL_PATH=./models/arcface_r100_224x224.onnx

# Model input size (Hi-Res ArcFace uses 224x224)
MODEL_INPUT_SIZE=224

# Face embedding dimension (typically 512 for ArcFace)
EMBEDDING_DIM=512

# ===== GPU Configuration =====
# GPU Device ID (0 for first GPU, -1 for CPU only)
GPU_DEVICE_ID=0

# GPU Memory Limit in bytes (2GB = 2147483648)
GPU_MEM_LIMIT=2147483648

# ===== API Server Configuration =====
API_HOST=0.0.0.0
API_PORT=8000

# API Environment (development, production)
ENVIRONMENT=development

# ===== Supabase Configuration =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== Face Recognition Configuration =====
# Minimum confidence threshold for face matching (0.0 to 1.0)
FACE_MATCH_THRESHOLD=0.6

# Maximum distance for cosine similarity (lower is better)
MAX_COSINE_DISTANCE=0.4
