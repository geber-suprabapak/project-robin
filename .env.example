# ===================================
# Face Recognition API Configuration
# ===================================

# ===== Image Configuration =====
# Used by docker compose. Defaults match the CI-published CPU image.
IMAGE_NAME=ghcr.io/geber-suprabapak/project-robin
IMAGE_TAG=cpu-latest

# ===== Model Configuration =====
# Path to ONNX model file inside the Docker container
MODEL_PATH=/app/runtime-models/glintr100.onnx

# Model input size (AuraFace glintr100 uses 112x112)
MODEL_INPUT_SIZE=112

# Face embedding dimension (typically 512 for ArcFace)
EMBEDDING_DIM=512

# CI smoke tests can start the API without a model. Keep false for real runtime.
SKIP_MODEL_LOAD=false

# Production default is offline-first: check mounted model files, do not download implicitly.
# Set true only when the server is allowed to fetch missing assets on startup/readiness.
AUTO_DOWNLOAD_MODELS=false
MODEL_DOWNLOAD_URL=https://huggingface.co/fal/AuraFace-v1/resolve/686774cad65e40933022896195e07e01ee06bee9/glintr100.onnx
MODEL_DOWNLOAD_CHECKSUM=sha256:a7933ea5330113b01c9b60351d8f4c33003f145d8470ac5f0e52ee2effe25c60

# ===== GPU Configuration =====
# GPU Device ID (0 for first GPU, -1 for CPU only)
GPU_DEVICE_ID=-1

# GPU Memory Limit in bytes (2GB = 2147483648)
GPU_MEM_LIMIT=2147483648

# ===== API Server Configuration =====
API_HOST=0.0.0.0
API_PORT=8000

# API Environment (development, production)
ENVIRONMENT=production

# Number of workers (only active in production mode)
API_WORKERS=1

# CORS is kept flexible for Android/native clients that use bearer tokens.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Request and image guardrails
MAX_REQUEST_BYTES=62914560
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16777216

# ===== Supabase Configuration =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Preferred for current Supabase asymmetric signing keys. Issuer must exactly match the token's iss claim.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Legacy HS256 fallback only. Leave empty when JWKS URL and issuer are configured.
SUPABASE_JWT_SECRET=your-jwt-secret-here

SUPABASE_TIMEOUT_SECONDS=3
SUPABASE_MAX_RETRIES=2

# ===== Face Recognition Configuration =====
# Minimum confidence threshold for face matching (0.0 to 1.0)
FACE_MATCH_THRESHOLD=0.6

# Face detector assets are baked into the official Docker image.
# These values are only needed when overriding the detector files.
FACE_DETECTOR_PROTOTXT_PATH=/app/models/face_detector/deploy.prototxt
FACE_DETECTOR_MODEL_PATH=/app/models/face_detector/res10_300x300_ssd_iter_140000.caffemodel
FACE_DETECTOR_PROTOTXT_URL=https://raw.githubusercontent.com/opencv/opencv/master/samples/dnn/face_detector/deploy.prototxt
FACE_DETECTOR_PROTOTXT_CHECKSUM=sha256:dcd661dc48fc9de0a341db1f666a2164ea63a67265c7f779bc12d6b3f2fa67e9
FACE_DETECTOR_MODEL_URL=https://raw.githubusercontent.com/opencv/opencv_3rdparty/dnn_samples_face_detector_20170830/res10_300x300_ssd_iter_140000.caffemodel
FACE_DETECTOR_MODEL_CHECKSUM=sha256:2a56a11a57a4a295956b0660b4a3d76bbdca2206c4961cea8efe7d95c7cb2f2d

# ===== Qdrant Configuration =====
# Qdrant is external-only in this compose stack.
QDRANT_HOST=https://your-qdrant-host.example.com

# Qdrant port (default: 6333 for REST API)
QDRANT_PORT=6333

# Collection name for face embeddings
QDRANT_COLLECTION_NAME=face_embeddings

# Qdrant API key (optional, required for Qdrant Cloud)
QDRANT_API_KEY=

# Whether to use HTTPS for Qdrant (default: false)
QDRANT_HTTPS=false

QDRANT_TIMEOUT_SECONDS=3
