# ============================================================================
# Face Recognition API - Dockerfile (CPU Version)
# Optimized for CPU Runtime (No NVIDIA/CUDA)
# ============================================================================

FROM python:3.12-slim-bookworm

# Metadata
LABEL maintainer="LunaraDev"
LABEL description="Face Recognition API with ONNX Runtime CPU support"
LABEL version="2.0.0-cpu"

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
# libgl1-mesa-glx and libglib2.0-0 are for OpenCV
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv process manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set working directory
WORKDIR /app

# Copy dependency files
# CRITICAL: We copy pyproject.toml.cpu to pyproject.toml to trick uv
COPY pyproject.toml.cpu ./pyproject.toml
# We exclude uv.lock because it likely contains GPU specific locks. 
# uv will resolve fresh for CPU.

# Install Python dependencies
# This creates a .venv in /app/.venv
RUN uv python install 3.12 && \
    uv sync --frozen --no-dev || uv sync --no-dev

# Copy application code
COPY . .

# Create directories for models and logs
RUN mkdir -p /app/models /app/logs

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application using uv
CMD ["uv", "run", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
